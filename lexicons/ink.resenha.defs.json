{
  "lexicon": 1,
  "id": "ink.resenha.defs",
  "description": "Views shared by the calls Resenha's server answers.",
  "defs": {
    "bookView": {
      "type": "object",
      "description": "Enough of a book to show a row. Cover and details come from BookHive's catalogue when the server has them; otherwise the app asks BookHive itself.",
      "required": [
        "hiveId"
      ],
      "properties": {
        "hiveId": {
          "type": "string",
          "maxLength": 64,
          "description": "The book's BookHive ID."
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "authors": {
          "type": "string",
          "maxLength": 1024,
          "description": "Authors as BookHive stores them, tab-separated."
        },
        "cover": {
          "type": "string",
          "format": "uri"
        },
        "year": {
          "type": "integer",
          "description": "Year of publication, from BookHive's catalogue."
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxLength": 32
        }
      }
    },
    "event": {
      "type": "object",
      "description": "Something a reader did with a book.",
      "required": [
        "uri",
        "kind",
        "actor",
        "book",
        "date",
        "source"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The record it comes from: the reader's BookHive book record."
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "started",
            "finished",
            "reviewed",
            "wantsToRead",
            "abandoned",
            "progress"
          ],
          "description": "What they did. wantsToRead and abandoned are dated by when the server saw the status change, else by when the book was added; progress by the record."
        },
        "actor": {
          "type": "string",
          "format": "did"
        },
        "book": {
          "type": "ref",
          "ref": "#bookView"
        },
        "date": {
          "type": "string",
          "format": "datetime"
        },
        "source": {
          "type": "string",
          "knownValues": [
            "bookhive",
            "popfeed",
            "resenha"
          ]
        },
        "stars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "In half stars, 1 to 10, as BookHive keeps them."
        },
        "excerpt": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000,
          "description": "The start of the review, plain text."
        },
        "review": {
          "type": "string",
          "maxGraphemes": 100000,
          "maxLength": 1000000,
          "description": "The whole review, plain markdown, on reviewed events and on finished ones that carry the review."
        },
        "progress": {
          "type": "ref",
          "ref": "#progressView"
        }
      }
    },
    "reviewView": {
      "type": "object",
      "required": [
        "uri",
        "author",
        "book",
        "createdAt",
        "source"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The review: a Standard.site document, a Popfeed review, or a BookHive book record with a review."
        },
        "author": {
          "type": "string",
          "format": "did"
        },
        "book": {
          "type": "ref",
          "ref": "#bookView"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "source": {
          "type": "string",
          "knownValues": [
            "bookhive",
            "popfeed",
            "resenha"
          ]
        },
        "title": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000
        },
        "excerpt": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000
        },
        "stars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "language"
          },
          "maxLength": 8
        },
        "hasSpoilers": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "maxGraphemes": 100000,
          "maxLength": 1000000,
          "description": "The whole review, when asked for with full."
        }
      }
    },
    "readerView": {
      "type": "object",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "readingNow": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#bookView"
          },
          "maxLength": 3
        },
        "followedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the caller followed them, for the caller's own list."
        },
        "joinedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When they started using Resenha."
        },
        "booksInCommon": {
          "type": "integer",
          "minimum": 0,
          "description": "With the caller, when sorted by similar."
        },
        "books": {
          "type": "integer",
          "minimum": 0,
          "description": "How many books they keep on BookHive."
        },
        "lastActivity": {
          "type": "string",
          "format": "datetime",
          "description": "When they last started, finished, changed or progressed in a book."
        },
        "followsYou": {
          "type": "boolean",
          "description": "Whether they follow the caller, as the server knows it."
        }
      }
    },
    "progressView": {
      "type": "object",
      "description": "How far through the book the reader is, as the record says.",
      "required": [
        "percent",
        "updatedAt"
      ],
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "currentPage": {
          "type": "integer",
          "minimum": 1
        },
        "totalPages": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "profileView": {
      "type": "object",
      "description": "Someone's name and picture, as Bluesky's AppView last gave them to the server; absent for a reader it hasn't fetched yet, whose name the app then finds itself.",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "handle": {
          "type": "string",
          "format": "handle"
        },
        "displayName": {
          "type": "string",
          "maxGraphemes": 64,
          "maxLength": 640
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "followerView": {
      "type": "object",
      "description": "Someone who follows the caller.",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "followedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When they followed, when the server heard the follow itself; absent for follows older than its listening."
        },
        "follows": {
          "type": "boolean",
          "description": "Whether the caller follows them back."
        },
        "books": {
          "type": "integer",
          "minimum": 0,
          "description": "How many books they keep in the index; 0 for someone who isn't a reader."
        },
        "readingNow": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#bookView"
          },
          "maxLength": 3
        }
      }
    },
    "suggestionView": {
      "type": "object",
      "description": "A reader worth following, for an empty Parlor.",
      "required": [
        "did",
        "source"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "source": {
          "type": "string",
          "knownValues": [
            "resenha",
            "bookhive",
            "popfeed"
          ],
          "description": "Where they read: Resenha's readers come first, then BookHive's and Popfeed's."
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "activeThisMonth": {
          "type": "integer",
          "minimum": 0,
          "description": "Books they started, finished, changed or progressed in over the last 30 days."
        },
        "reviews": {
          "type": "integer",
          "minimum": 0
        },
        "books": {
          "type": "integer",
          "minimum": 0
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "language"
          },
          "description": "The languages they said their reviews are in."
        },
        "latestReview": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "format": "datetime"
            },
            "title": {
              "type": "string"
            },
            "excerpt": {
              "type": "string",
              "maxGraphemes": 200
            }
          }
        }
      }
    },
    "starterPackView": {
      "type": "object",
      "description": "A starter pack the server keeps in the official account.",
      "required": [
        "uri",
        "name",
        "members"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "list": {
          "type": "string",
          "format": "at-uri",
          "description": "The reference list the pack is built on."
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "did"
          },
          "maxLength": 150
        },
        "updatedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
