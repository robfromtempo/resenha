{
  "lexicon": 1,
  "id": "ink.resenha.parlor.getStarterPacks",
  "description": "The starter packs Resenha keeps in its official account, with their members, for an empty Parlor.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requires the caller's service token.",
      "parameters": {
        "type": "params",
        "properties": {}
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "packs"
          ],
          "properties": {
            "packs": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#starterPackView"
              }
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#profileView"
              }
            }
          }
        }
      }
    }
  }
}
