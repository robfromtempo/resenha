{
  "lexicon": 1,
  "id": "ink.resenha.parlor.reportComment",
  "description": "Reports a Resenha comment to Resenha's maintainer, who can remove it from every reader's thread. Bluesky's moderators don't read these records, so the report comes here.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Requires the caller's service token.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "uri",
            "reason"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri",
              "description": "The comment."
            },
            "reason": {
              "type": "string",
              "description": "A com.atproto.moderation.defs reason, such as com.atproto.moderation.defs#reasonRude."
            },
            "note": {
              "type": "string",
              "maxGraphemes": 1000,
              "maxLength": 10000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      }
    }
  }
}
