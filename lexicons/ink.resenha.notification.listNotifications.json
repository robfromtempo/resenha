{
  "lexicon": 1,
  "id": "ink.resenha.notification.listNotifications",
  "description": "The caller's notifications from Bluesky, BookHive, Popfeed, comics and Resenha, newest first.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requires the caller's service token.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Where the previous page ended."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Where the previous page ended."
            },
            "notifications": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#notification"
              }
            },
            "seenAt": {
              "type": "string",
              "format": "datetime"
            }
          },
          "required": [
            "notifications"
          ]
        }
      }
    },
    "notification": {
      "type": "object",
      "required": [
        "uri",
        "kind",
        "source",
        "author",
        "indexedAt"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The record that caused it."
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "follow",
            "friendRequest",
            "like",
            "quote",
            "reviewComment",
            "reply",
            "comicComment"
          ]
        },
        "source": {
          "type": "string",
          "knownValues": [
            "bluesky",
            "popfeed",
            "bookhive",
            "resenha",
            "sequential"
          ]
        },
        "author": {
          "type": "string",
          "format": "did"
        },
        "subject": {
          "type": "string",
          "format": "at-uri",
          "description": "What it's about: the caller's post, review or comment."
        },
        "review": {
          "type": "string",
          "format": "at-uri",
          "description": "The caller's review it groups under, when there is one: its post, Popfeed review or book record."
        },
        "text": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
