{
  "lexicon": 1,
  "id": "ink.resenha.notification.listNotifications",
  "description": "The caller's notifications from Bluesky, BookHive, Popfeed, comics and Resenha, newest first.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requires the caller's service token. Only the caller's own.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Where the previous page ended."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "capabilities": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "string",
              "maxLength": 64,
              "knownValues": [
                "shop"
              ]
            },
            "description": "What the app can show: with shop, the Shop's availability notifications are included."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Where the previous page ended."
            },
            "notifications": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#notification"
              }
            },
            "seenAt": {
              "type": "string",
              "format": "datetime"
            },
            "preferences": {
              "type": "ref",
              "ref": "#preferences"
            }
          },
          "required": [
            "notifications"
          ]
        }
      }
    },
    "notification": {
      "type": "object",
      "required": [
        "uri",
        "kind",
        "source",
        "author",
        "indexedAt"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The record that caused it."
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "follow",
            "friendRequest",
            "like",
            "quote",
            "reviewComment",
            "reply",
            "comicComment",
            "readingLike",
            "readingComment",
            "shopAvailable"
          ],
          "description": "like and quote group under their review; readingLike groups under the book record it's on, and readingComment is a comment on the caller reading a book; reply is to a comment of the caller's, on Bluesky (with thread), Popfeed, BookHive or Resenha (with thread, the book record). shopAvailable: a book the caller asked for is now in the Shop (from the official account; subject is the book page's key, book the page and its title, format what arrived)."
        },
        "source": {
          "type": "string",
          "knownValues": [
            "bluesky",
            "popfeed",
            "bookhive",
            "resenha",
            "sequential"
          ]
        },
        "author": {
          "type": "string",
          "format": "did"
        },
        "subject": {
          "type": "string",
          "description": "What it's about: the caller's post, review or comment (an at-uri), or for shopAvailable the key of the book page the request was made on."
        },
        "review": {
          "type": "string",
          "format": "at-uri",
          "description": "The caller's review it groups under, when there is one: its post, Popfeed review or book record."
        },
        "text": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        },
        "thread": {
          "type": "string",
          "format": "at-uri",
          "description": "For a reply to the caller's comment: the post the thread hangs from, some reader's review."
        },
        "book": {
          "type": "object",
          "description": "For readingLike, readingComment and a Resenha reply: the caller's book.",
          "properties": {
            "hiveId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "format": {
          "type": "string",
          "knownValues": [
            "ebook",
            "audiobook"
          ],
          "description": "For shopAvailable: the format that arrived."
        }
      }
    },
    "preferences": {
      "type": "object",
      "required": [
        "likes"
      ],
      "properties": {
        "likes": {
          "type": "string",
          "knownValues": [
            "everyone",
            "following",
            "off"
          ],
          "description": "Whose likes and quotes are pushed to the caller's devices. They're always listed."
        }
      }
    }
  }
}
