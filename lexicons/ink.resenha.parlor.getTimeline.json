{
  "lexicon": 1,
  "id": "ink.resenha.parlor.getTimeline",
  "description": "What the readers the caller follows did with their books, newest first: started, finished, reviewed, wanted to read, abandoned, and progress; with their names and pictures and the books' covers as the server has them.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requires the caller's service token.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Where the previous page ended."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "since": {
            "type": "string",
            "format": "datetime",
            "description": "Only what's newer than this, for a cheap refresh. Ignored with a cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Where the previous page ended."
            },
            "events": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#event"
              }
            },
            "readers": {
              "type": "integer",
              "minimum": 0,
              "description": "How many of the caller's follows have books in the index."
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#profileView"
              },
              "description": "The names and pictures of the events' readers, those the server has."
            }
          },
          "required": [
            "events"
          ]
        }
      }
    }
  }
}
