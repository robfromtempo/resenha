{
  "lexicon": 1,
  "id": "ink.resenha.parlor.getTimeline",
  "description": "What the readers the caller follows started, finished and reviewed, newest first.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requires the caller's service token.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Where the previous page ended."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Where the previous page ended."
            },
            "events": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#event"
              }
            }
          },
          "required": [
            "events"
          ]
        }
      }
    }
  }
}
