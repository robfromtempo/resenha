{
  "lexicon": 1,
  "id": "ink.resenha.moderation.listReports",
  "description": "The reports on Resenha comments, for a maintainer: open ones newest first, or the resolved ones.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requires a maintainer's service token.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": {
            "type": "string",
            "knownValues": [
              "open",
              "resolved"
            ],
            "default": "open"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reports"
          ],
          "properties": {
            "reports": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#reportView"
              }
            },
            "cursor": {
              "type": "string"
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#profileView"
              },
              "description": "The comments' authors and the reporters, those the server has."
            }
          }
        }
      }
    }
  }
}
