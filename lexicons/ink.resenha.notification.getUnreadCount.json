{
  "lexicon": 1,
  "id": "ink.resenha.notification.getUnreadCount",
  "description": "How many notifications the caller hasn't seen.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Likes on one review count once, as the app shows them. The Shop's notifications count only with capabilities shop.",
      "parameters": {
        "type": "params",
        "properties": {
          "capabilities": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "string",
              "maxLength": 64,
              "knownValues": [
                "shop"
              ]
            },
            "description": "What the app can show: with shop, the Shop's availability notifications are included."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "count"
          ]
        }
      }
    }
  }
}
