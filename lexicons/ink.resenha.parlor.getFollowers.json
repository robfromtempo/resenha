{
  "lexicon": 1,
  "id": "ink.resenha.parlor.getFollowers",
  "description": "Who follows the caller, newest first: the readers among them by default, or everyone. The server pages the caller's followers from Bluesky's AppView once a week and hears new follows as they happen.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requires the caller's service token.",
      "parameters": {
        "type": "params",
        "properties": {
          "scope": {
            "type": "string",
            "knownValues": [
              "readers",
              "everyone"
            ],
            "default": "readers"
          },
          "cursor": {
            "type": "string",
            "description": "Where the previous page ended."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "followers",
            "count",
            "readersCount"
          ],
          "properties": {
            "followers": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#followerView"
              }
            },
            "cursor": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Everyone the server knows follows the caller."
            },
            "readersCount": {
              "type": "integer",
              "minimum": 0
            },
            "listedAt": {
              "type": "string",
              "format": "datetime",
              "description": "When the server last paged the caller's followers from the AppView; absent until it has, when only follows it heard itself are known."
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "ink.resenha.defs#profileView"
              }
            }
          }
        }
      }
    }
  }
}
